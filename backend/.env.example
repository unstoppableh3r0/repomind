# RepoMind Backend Environment Variables
# Copy this to .env and fill in your values

# ── Application ─────────────────────────────────────────────
DEBUG=true
SECRET_KEY=dev-secret-key-12345

# ── Database ────────────────────────────────────────────────
# For local development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./repomind.db

# For production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/repomind

# ── AI (OpenAI) ─────────────────────────────────────────────
# IMPORTANT: Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-actual-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── GitHub (optional, for private repos) ────────────────────
GITHUB_TOKEN=

# ── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Storage ─────────────────────────────────────────────────
# Defaults to relative paths in the project root
REPOS_DIR=./data/repos
FAISS_INDEX_DIR=./data/faiss
